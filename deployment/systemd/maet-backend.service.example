[Unit]
Description=MAET Terminal FastAPI Backend
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=maet
Group=maet
WorkingDirectory=/opt/maet-terminal
EnvironmentFile=/etc/maet-terminal/backend.env
ExecStart=/opt/maet-terminal/.venv/bin/uvicorn backend.api_server:app --host ${HOST} --port ${PORT} --ws-ping-interval 20 --ws-ping-timeout 30
Restart=always
RestartSec=5
TimeoutStopSec=30
KillSignal=SIGINT

[Install]
WantedBy=multi-user.target
