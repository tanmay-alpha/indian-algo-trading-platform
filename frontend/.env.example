# MAET Terminal Environment Variables
# Copy this file to .env.local and update values

NEXT_PUBLIC_BACKEND_URL=https://maet-backend.onrender.com
NEXT_PUBLIC_WS_URL=wss://maet-backend.onrender.com/ws

# Local development examples:
NEXT_PUBLIC_BACKEND_URL_LOCAL=http://localhost:8000
NEXT_PUBLIC_WS_URL_LOCAL=ws://localhost:8000/ws/market_stream

# Legacy aliases kept for older code paths:
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
NEXT_PUBLIC_API_URL=http://localhost:8000

# Production examples:
# NEXT_PUBLIC_API_BASE_URL=https://maet-backend.onrender.com
# NEXT_PUBLIC_API_URL=https://maet-backend.onrender.com
# NEXT_PUBLIC_WS_URL=wss://maet-backend.onrender.com/ws
