# MAET Terminal local backend environment template.
# Copy to .env for local development and fill private values locally.
# Never commit real credentials.

ANGEL_API_KEY=
ANGEL_CLIENT_CODE=
ANGEL_CLIENT_ID=
ANGEL_PASSWORD=
ANGEL_TOTP_SECRET=

TRADING_MODE=PAPER
LIVE_TRADING_ENABLED=false
DEMO_MODE=false

HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO
LOG_DIR=logs
DB_PATH=data/trades.db
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
ENVIRONMENT=LOCAL
PUBLIC_BACKEND_URL=http://localhost:8000

SYMBOLS=["SBIN","RELIANCE"]
MAX_ORDER_QTY=500
MAX_ORDER_NOTIONAL=500000.0
MAX_DAILY_LOSS=-25000.0
JWT_REFRESH_INTERVAL_MINUTES=30
WS_RECONNECT_DELAY_SECONDS=3
