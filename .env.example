# MAET Terminal local backend environment template.
# Copy to .env for local development and fill private values locally.
# Never commit real credentials.

ANGEL_API_KEY=
ANGEL_CLIENT_CODE=
ANGEL_CLIENT_ID=
ANGEL_PASSWORD=
ANGEL_TOTP_SECRET=

TRADING_MODE=PAPER
LIVE_TRADING_ENABLED=false
DEMO_MODE=false
# Optional: set a token to protect sensitive routes in demo deployment.
# Leave empty to disable admin auth and keep the demo open.
ADMIN_TOKEN=

HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO
LOG_DIR=logs
DB_PATH=data/trades.db
DATABASE_URL=your_postgresql://maet:maet_dev_password@localhost:5432/maet_terminal
REDIS_URL=redis://localhost:6379/0
LIVE_EXECUTION_ENABLED=false
ALLOW_LIVE_ORDERS=false
LIVE_APPROVAL_SANDBOX_ENABLED=false
ALLOWED_ORIGINS=http://localhost:3000
# Render production example:
# ALLOWED_ORIGINS=https://indian-algo-trading-platform.vercel.app
ENVIRONMENT=LOCAL
PUBLIC_BACKEND_URL=http://localhost:8000

# NSE symbols to subscribe for live market data.
# All symbols must have verified tokens in the instrument registry.
# Default: 10 Nifty 50 large-caps with confirmed Angel One tokens.
# Max practical limit on Render Free: ~15-20 symbols.
# Example deploy value:
# SYMBOLS=["SBIN","RELIANCE","INFY","TCS","HDFCBANK","ICICIBANK","AXISBANK","WIPRO","ITC","TATASTEEL"]
SYMBOLS=your_symbols_json_array
MAX_ORDER_QTY=500
MAX_ORDER_NOTIONAL=500000.0
MAX_DAILY_LOSS=-25000.0
JWT_REFRESH_INTERVAL_MINUTES=30
WS_RECONNECT_DELAY_SECONDS=3
